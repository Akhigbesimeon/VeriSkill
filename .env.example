# ─────────────────────────────────────────────────────────────────
# VeriSkill — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────

# Application 
NODE_ENV=local                        # local, staging, production
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173 # Comma-separated for multiple

# Database 
DATABASE_URL=postgresql://veriskill:password@localhost:5432/veriskill_dev
DATABASE_SSL=false                    # true in staging/production

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Blockchain
RPC_URL=http://127.0.0.1:8545        # Hardhat local node
CONTRACT_ADDRESS=                    # update after each deploy
# WARNING: These keys are server-side only. Never expose to client.
ISSUER_PRIVATE_KEY=
ADMIN_PRIVATE_KEY=

# GitHub Scanning
# Create a fine-grained token with public_repo read access only.
# Never use a personal token with write scopes.
GITHUB_TOKEN=REPLACE_WITH_GITHUB_READ_ONLY_TOKEN

# Job Queue (Redis)
REDIS_URL=redis://localhost:6379

# Rate Limiting 
RATE_LIMIT_WINDOW_MS=900000           # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# URL Verification 
URL_FETCH_TIMEOUT_MS=10000            # 10 seconds
URL_FETCH_MAX_RESPONSE_BYTES=2097152  
URL_FETCH_MAX_REDIRECTS=3
