# Mobile app env — copy to `.env` and fill in real values.
# Variables prefixed with EXPO_PUBLIC_ are inlined into the bundle at build
# time, so restart `expo start -c` after any change.

# Shared secret with the backend's MOBILE_API_KEY. Required for the mobile
# recruiter-only gate to activate. Must match the backend value exactly.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPO_PUBLIC_MOBILE_KEY=REPLACE_WITH_32_BYTE_HEX_SECRET

# Backend API base URL. Default (unset) is http://localhost:4000/api/v1 —
# works for the iOS simulator and web preview, but NOT physical devices.
# For a device on the same LAN, use your dev machine's IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:4000/api/v1
