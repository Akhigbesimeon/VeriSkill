# ─────────────────────────────────────────────────────────────────
# VeriSkill web (developer app) — Vite env reference
# Copy to apps/web/.env.local for local dev, or set in Vercel
# project settings for staging/production (ADR-015 companion to Render).
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# ─────────────────────────────────────────────────────────────────

# Backend base URL — the Render service for staging/production,
# empty for local dev (vite.config.ts proxies /api to localhost:4000)
VITE_API_BASE_URL=
# VITE_API_BASE_URL=

# Public verification URL printed into recruiter-facing QR codes
VITE_PUBLIC_VERIFY_BASE_URL=
