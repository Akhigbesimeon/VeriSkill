{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node", "mocha", "chai"],
    "resolveJsonModule": true
    
  },
  "ts-node": {
    "compilerOptions": {
      "module": "node16",
      "moduleResolution": "node16"
    }
  },
  "include": [
    "./hardhat.config.ts", 
    "./contracts/**/*.sol", 
    "./test/**/*.ts", 
    "./scripts/**/*.ts"
  ],
  "exclude": ["node_modules"]
}